<?xml version="1.0"?>
<ruleset name="Example Plugin">
	<description>WordPress Coding Standards for the Example Plugin starter.</description>
	<file>.</file>
	<exclude-pattern>vertex/*</exclude-pattern>
	<exclude-pattern>vendor/*</exclude-pattern>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="sp"/>
	<config name="minimum_supported_wp_version" value="6.3"/>
	<rule ref="WordPress">\n\t\t<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>\n\t</rule>\n</ruleset>